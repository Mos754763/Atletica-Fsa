{
  "name": "atletica-fsa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:wcag-contrast": "vitest run src/app/wcag-contrast.test.ts",
    "test:slack-webhook": "RUN_LIVE_SLACK_WEBHOOK_TEST=true vitest run src/lib/integrations/slack-webhook.secret.test.ts",
    "test:point-resilience": "vitest run src/lib/payments/point-resilience.test.ts",
    "test:integration:qr-concurrency": "RUN_QR_CONCURRENCY_TESTS=true node scripts/test-qr-concurrency.mjs",
    "qa:homologation": "node scripts/qa-homologation.mjs",
    "audit:catalog-media": "node scripts/audit-catalog-media.mjs",
    "seed:catalog-images": "node scripts/seed-catalog-images.mjs",
    "diagnose:cron": "node scripts/diagnose-cron-health.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "postcss": "8.5.26",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.1.2",
    "sharp": "0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.4.1"
}

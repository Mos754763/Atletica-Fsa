# Supabase (public values are safe for browser use; secret value stays server-only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# Exclusiva para execução local de migrações; nunca configure esta variável na Vercel.
SUPABASE_DB_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres

# Banco Supabase exclusivo para testes de integração. Nunca use valores de produção.
TEST_SUPABASE_PROJECT_REF=projeto_de_teste
TEST_SUPABASE_URL=https://projeto-de-teste.supabase.co
TEST_SUPABASE_SECRET_KEY=sb_secret_apenas_ambiente_de_teste
TEST_SUPABASE_DB_URL=postgresql://postgres:password@db.projeto-de-teste.supabase.co:5432/postgres

# Resend (server-only)
RESEND_API_KEY=re_your_key
EMAIL_FROM=ATLETICA FSA <contato@seudominio.com>

# Mercado Pago (server-only; configure only when ready)
# PAYMENTS_ENABLED é apenas fallback legado durante a migração; mantenha false.
PAYMENTS_ENABLED=false
# Novos checkouts podem ser fechados sem interromper obrigações já criadas.
ACCEPT_NEW_CHECKOUTS=false
# Mantenha true durante o drain; desligue somente após comprovar zero obrigações abertas.
PROCESS_PAYMENT_EVENTS=true
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# Protege a Vercel Cron que envia lembretes de evento
CRON_SECRET=troque-por-um-segredo-aleatorio-longo

# Integrações operacionais (server-only)
SYMPLA_API_TOKEN=
SLACK_SYMPLA_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/SEU_WORKSPACE/SEU_APP/SEU_SEGREDO

# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile (somente a Sitekey pública; a Secret Key é cadastrada apenas no painel Supabase)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
